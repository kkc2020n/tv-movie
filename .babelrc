{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": "> 0.5%, last 2 versions, not dead",
        "useBuiltIns": "usage",
        "corejs": 3
      }
    ],
    [
      "@babel/preset-react",
      { "runtime": "automatic" }
    ]
  ],
  "env": {
    "development": {
      "presets": [
        ["@babel/preset-react", { "runtime": "automatic", "development": true }]
      ]
    }
  }
}
